# Nginx reverse proxy for Royal63 — copy to /etc/nginx/sites-available/royal63,
# replace royal63.club with your real domain, then:
#   sudo ln -s /etc/nginx/sites-available/royal63 /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
# Afterwards run certbot (see DEPLOY.md) — it edits this file automatically
# to add the HTTPS server block and redirect.

server {
    listen 80;
    listen [::]:80;
    server_name royal63.club www.royal63.club;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
