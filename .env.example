JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Telegram bot (optional) — leave unset to disable the bot entirely.
# TELEGRAM_BOT_TOKEN: from @BotFather after creating the bot.
# TELEGRAM_BOT_USERNAME: the bot's @username (no @), used to build the
#   t.me deep link shown to clients after they submit a registration.
# TELEGRAM_ADMIN_CHAT_ID: chat id of the private group/chat where staff
#   get notified about new registrations.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_CHAT_ID=
# Set after /miniapp is deployed at this HTTPS address. The bot will then
# display an "Открыть клуб" button that opens the Mini App.
# TELEGRAM_MINI_APP_URL=https://royal-63.ru/miniapp
# Optional: use only when the server cannot reach api.telegram.org directly.
# TELEGRAM_PROXY_URL=
# TELEGRAM_API_BASE=

# Analytics (optional) — leave unset to disable, no cookies are set until
# an ID is filled in. Create accounts at metrika.yandex.ru / analytics.google.com.
NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_GA_ID=
